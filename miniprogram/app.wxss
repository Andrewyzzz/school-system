page {
  min-height: 100%;
  background: #f5f7f8;
  color: #172126;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
}

.page-title {
  margin: 8rpx 0 24rpx;
}

.eyebrow {
  color: #667985;
  font-size: 24rpx;
}

.h1 {
  display: block;
  margin-top: 8rpx;
  color: #0f2526;
  font-size: 44rpx;
  font-weight: 800;
}

.card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e2e8ec;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 14rpx 40rpx rgba(23, 33, 38, 0.06);
}

.card-title {
  display: block;
  margin-bottom: 10rpx;
  color: #102729;
  font-size: 32rpx;
  font-weight: 750;
}

.muted {
  color: #6b7e88;
  font-size: 24rpx;
  line-height: 1.5;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.metric {
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f0fdfa;
}

.metric text {
  display: block;
}

.metric .value {
  margin-top: 8rpx;
  color: #0f766e;
  font-size: 40rpx;
  font-weight: 800;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.primary-button,
.ghost-button,
.danger-button {
  min-height: 82rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.primary-button {
  background: #0f766e;
  color: #fff;
}

.ghost-button {
  border: 1rpx solid #d4e2e5;
  background: #fff;
  color: #0f766e;
}

.danger-button {
  background: #fff1f2;
  color: #be123c;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 12rpx 0 22rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d7e2e5;
  border-radius: 14rpx;
  background: #fff;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  padding: 22rpx;
  border: 1rpx solid #e2e8ec;
  border-radius: 14rpx;
  background: #fff;
}

.item-main {
  display: block;
  color: #12282b;
  font-size: 30rpx;
  font-weight: 700;
}

.item-meta {
  display: block;
  margin-top: 8rpx;
  color: #627781;
  font-size: 24rpx;
  line-height: 1.45;
}

.tag {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #0369a1;
  font-size: 22rpx;
}

.tag.done {
  background: #dcfce7;
  color: #15803d;
}

.tag.warn {
  background: #fef3c7;
  color: #a16207;
}

.tag.error {
  background: #ffe4e6;
  color: #be123c;
}

.empty {
  padding: 36rpx 20rpx;
  color: #78909a;
  text-align: center;
}

.nav-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.nav-card {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(23, 33, 38, 0.06);
}

.nav-card text {
  display: block;
}
