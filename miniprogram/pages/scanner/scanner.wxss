.picker-box {
  min-height: 78rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d7e2e5;
  border-radius: 14rpx;
  color: #0f766e;
}

.lesson-box {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f0fdfa;
}

.screen-url {
  display: block;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #eef5f6;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}
