<view class="page">
  <view class="page-title">
    <text class="eyebrow">月度确认</text>
    <text class="h1">工作量确认</text>
    <text class="muted">老师确认后进入教务、总校、财务结算链路。</text>
  </view>

  <view class="card">
    <text class="card-title">确认状态</text>
    <text class="item-main">{{statusText}}</text>
    <text class="item-meta">计划 {{summary.plannedUnits || 0}} 节 · 可计薪 {{summary.payableUnits || 0}} 节 · 待处理 {{summary.pendingCount || 0}} · 异常 {{summary.exceptionCount || 0}}</text>
    <button class="primary-button" loading="{{confirming}}" disabled="{{confirmDisabled}}" bindtap="confirmWorkload">确认本月工作量</button>
  </view>

  <view wx:if="{{payableLines.length}}" class="card">
    <text class="card-title">可计薪课时</text>
    <view class="list">
      <view class="list-item" wx:for="{{payableLines}}" wx:key="lessonId">
        <text class="item-main">{{item.date}} · {{item.subjectName}} · {{item.className}}</text>
        <text class="item-meta">{{item.time}} · {{item.room}} · {{item.units}} 节</text>
      </view>
    </view>
  </view>

  <view wx:if="{{pendingLines.length}}" class="card">
    <text class="card-title">待处理课时</text>
    <view class="list">
      <view class="list-item" wx:for="{{pendingLines}}" wx:key="lessonId">
        <text class="item-main">{{item.date}} · {{item.subjectName}} · {{item.className}}</text>
        <text class="item-meta">{{item.time}} · {{item.room}} · {{item.statusText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{exceptionLines.length}}" class="card">
    <text class="card-title">异常课时</text>
    <view class="list">
      <view class="list-item" wx:for="{{exceptionLines}}" wx:key="lessonId">
        <text class="item-main">{{item.date}} · {{item.subjectName}} · {{item.className}}</text>
        <text class="item-meta">{{item.note}}</text>
        <text class="tag error">异常</text>
      </view>
    </view>
  </view>
</view>
