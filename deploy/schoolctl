#!/usr/bin/env bash
# 服务启停与日常运维（验收 6.4 / 6.6）
#
#   schoolctl start|stop|restart|status
#   schoolctl logs [行数]      查看服务日志
#   schoolctl health           健康检查
#   schoolctl backup           立即备份
#   schoolctl config           查看当前配置（密钥已打码）
#   schoolctl doctor           一键体检：服务、数据库、权限、备份、配置
set -euo pipefail

APP_DIR="${APP_DIR:-/opt/school-system}"
CONF="${APP_DIR}/config/production.env"
UNIT=school-system
ok()   { printf '\033[1;32m  ✓ %s\033[0m\n' "$*"; }
bad()  { printf '\033[1;31m  ✗ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m  ! %s\033[0m\n' "$*"; }

case "${1:-status}" in
  start|stop|restart)
    systemctl "$1" "${UNIT}"
    systemctl --no-pager status "${UNIT}" | head -5
    ;;
  status)
    systemctl --no-pager status "${UNIT}" | head -12
    ;;
  logs)
    journalctl -u "${UNIT}" -n "${2:-100}" --no-pager
    ;;
  follow)
    journalctl -u "${UNIT}" -f
    ;;
  health)
    curl -fsS http://127.0.0.1:4173/api/health | python3 -m json.tool
    ;;
  backup)
    cd "${APP_DIR}" && node --env-file="${CONF}" scripts/backup-db.js
    ;;
  config)
    cd "${APP_DIR}" && node --env-file="${CONF}" -e '
      const { inspectConfig } = await import("./server/config.js");
      const r = inspectConfig();
      console.log(`环境：${r.profile}`);
      r.items.forEach((i) => console.log(`  ${i.key.padEnd(24)} ${i.value || "（未配置）"}${i.usingDefault ? "  [默认值]" : ""}`));
      r.warnings.forEach((w) => console.log(`  ! ${w}`));
    ' --input-type=module
    ;;
  doctor)
    # 一律用 if/else，不用 A && B || C：后者在 B 失败时也会执行 C，
    # 体检就会出现「运行中」和「未运行」同时打印这种自相矛盾的输出
    echo "服务"
    if systemctl is-active --quiet "${UNIT}"; then ok "运行中"; else bad "未运行（schoolctl logs 查看原因）"; fi
    if systemctl is-enabled --quiet "${UNIT}"; then ok "已设开机自启"; else warn "未设开机自启"; fi

    echo "接口"
    if curl -fsS http://127.0.0.1:4173/api/health >/dev/null 2>&1; then ok "健康检查通过"; else bad "健康检查失败"; fi

    echo "数据库"
    if systemctl is-active --quiet postgresql; then ok "PostgreSQL 运行中"; else bad "PostgreSQL 未运行"; fi
    cd "${APP_DIR}" && node --env-file="${CONF}" scripts/provision-db-roles.js --check 2>&1 | grep -E "✓|✗" || true

    echo "备份"
    # 用 find 而不是 ls：文件名含空格或换行时 ls 的输出没法安全解析
    LATEST=$(find "${BACKUP_DIR:-/var/backups/school-system}" -maxdepth 1 -name '*.dump' -type f -print0 2>/dev/null \
      | xargs -0 ls -t 2>/dev/null | head -1 || true)
    if [ -n "${LATEST}" ]; then
      AGE=$(( ($(date +%s) - $(stat -c %Y "${LATEST}")) / 3600 ))
      # 超过 48 小时说明定时任务没在跑，而不是"最近没改数据"
      if [ "${AGE}" -lt 48 ]; then
        ok "最近备份 ${AGE} 小时前"
      else
        bad "最近备份已是 ${AGE} 小时前，定时备份可能未运行"
      fi
      cd "${APP_DIR}" && node scripts/backup-db.js --verify "${LATEST}" 2>&1 | sed 's/^/  /'
    else
      bad "没有找到任何备份"
    fi

    echo "口令"
    cd "${APP_DIR}" && node --env-file="${CONF}" scripts/rotate-passwords.js --check 2>&1 | grep -E "✓|✗" | head -2 || true
    ;;
  *)
    sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
