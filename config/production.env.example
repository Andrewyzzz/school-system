# 生产环境配置（验收 6.5）
#
# 用法：
#   cp config/production.env.example config/production.env
#   编辑填入真实值，然后
#   node --env-file=config/production.env server/server.js
#
# config/*.env 已在 .gitignore 中——里面有数据库口令和加密密钥，绝不能进版本库。

NODE_ENV=production

# --- 服务 ---
PORT=4173
# 只监听本机，由 Nginx 反代过来。直接监听 0.0.0.0 等于把未加密的 HTTP 端口
# 暴露在校园网上，工资和身份证会明文过网。
HOST=127.0.0.1

# --- 数据库 ---
# 用 school_app 程序账号，不要用超级用户。账号由 scripts/provision-db-roles.js 创建。
DATABASE_URL=postgresql://school_app:请填写口令@127.0.0.1:5432/school_system
PG_POOL_MAX=20

# --- 加密 ---
# 身份证、银行卡、工资金额的加密密钥。生成：openssl rand -hex 32
#
# 这把钥匙必须与数据库备份分开保管。放在同一台机器上等于没加密——
# 拿到备份的人同时拿到了钥匙。丢了它，已加密的数据永久无法恢复。
HR_ENCRYPTION_KEY=请填写64位hex

# --- 排课求解器 ---
# 指向装了 ortools 的 python。缺失时排课会退化成启发式算法，
# 结果可用但质量下降，且不会有任何报错——所以生产必须配。
SCHEDULER_PYTHON=/opt/school-system/.venv-solver/bin/python

# --- 安全 ---
# 部署在 Nginx 后面必须为 1，否则限流拿到的都是代理 IP，全校共用一个额度
TRUST_PROXY=1
# 确认 HTTPS 证书已就绪后再设为 1。明文 HTTP 下发 HSTS 会把整站锁死。
FORCE_HTTPS=1
# 前后端同源时留空。绝不填 *。
CORS_ALLOW_ORIGIN=
# 校园网 NAT 后全校共用出口 IP，早高峰集中登录是正常流量，不要调低
LOGIN_MAX_PER_IP=3000
# 失败次数上限，用于拦跨账号撞库
LOGIN_FAIL_MAX_PER_IP=60

# --- 备份 ---
# 建议指向与数据库不同的磁盘，并定期同步到异机
BACKUP_DIR=/var/backups/school-system

# --- 监控与告警（合同第七条第 6 项）---
# 每 5 分钟自动检查一轮，异常时推送站内通知给系统管理员。
# 同一个故障只通知一次，持续未恢复则按下面的间隔重播。
MONITOR_REPEAT_HOURS=6
# 进程内存超过这个值告警。归档往年账套可以显著降低内存占用
MONITOR_MEMORY_LIMIT_MB=1536
# 备份超过这么多天没更新就告警
MONITOR_BACKUP_MAX_DAYS=2
# 一小时内全站登录失败次数上限，用于发现口令爆破。
# 与 LOGIN_FAIL_MAX_PER_IP 不同：那个是按单 IP 限流，
# 这个是全站统计——爆破常常是很多 IP 各试几次，单个都不触发限流
MONITOR_LOGIN_FAIL_LIMIT=100
# 超过 3 个工作日未处理的审批条数上限
MONITOR_APPROVAL_BACKLOG=20
# 可选：钉钉/企业微信机器人地址。不配则只走日志与站内通知。
# 推送失败不会影响系统运行，只在日志里留一行
# MONITOR_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
